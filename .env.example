# Copy to .env in this folder and fill in. Never commit .env.
# On GitHub the same values are repository secrets (see README.md).

# Azure database, schema jb_kb, login jb_court
DATABASE_URL=postgresql+asyncpg://jb_court:PASSWORD@HOST:5432/jurisbound_dev_db?ssl=require
SYNC_DATABASE_URL=postgresql://jb_court:PASSWORD@HOST:5432/jurisbound_dev_db?sslmode=require

# Azure Blob Storage
STORAGE_BACKEND=azure
AZURE_STORAGE_CONNECTION_STRING=
SUPABASE_S3_BUCKET=court-documents

# eCourts app lookup for case details (mobile = on)
DC_LOOKUP=mobile
